# Copy this file to .env.local and fill in real values.
# Nothing in this file is committed with real secrets — see docs/ARCHITECTURE.md
# "Data Architecture" section for how each value is used.

# Public site URL (used for canonical links, sitemap, and JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.getagefit.com

# --- Analytics -------------------------------------------------------------
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_ID=

# Microsoft Clarity project ID
NEXT_PUBLIC_CLARITY_ID=

# --- CRM integration ---------------------------------------------------
# Generic webhook endpoint the API routes POST leads/qualification/consultation
# requests to (e.g. a CRM's inbound webhook, Zapier/Make catcher, or HubSpot
# forms API). Leave blank during development — submissions are logged only.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Airtable Automation "when webhook received" endpoint used by the
# /consultation funnel only (src/lib/airtable.ts, forwardToAirtable()).
# Separate from the direct Airtable API integration below. Leave blank
# during development — submissions are logged only.
AIRTABLE_WEBHOOK_URL=

# --- Airtable direct integration (Coaching OS) --------------------------
# Server-side only (never exposed to the browser) — used by
# src/lib/airtableClient.ts for the qualification funnel's direct Lead
# create/update via the Airtable REST API (find existing Lead by email,
# update it, or create a new one). Leave blank during development —
# qualification submissions still succeed; the Airtable write is skipped
# and logged server-side only, same graceful-degradation pattern as the
# rest of this file.
AIRTABLE_ACCESS_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_LEADS_TABLE_ID=

# --- Consultation booking -----------------------------------------------
# If GetAgeFit uses a booking tool (Calendly, Acuity, etc.), put the
# scheduling URL here so the Consultation page can embed/link it.
NEXT_PUBLIC_BOOKING_URL=
